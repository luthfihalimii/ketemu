APP_NAME="KETEMU PENS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated proxy IPs/CIDRs. Never trust arbitrary forwarded headers.
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ketemupens
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true in production. Override only for local HTTP development.
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# PRODUCTION: wajib SMTP sungguhan agar verifikasi email + notifikasi sampai.
# Contoh:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.pens.ac.id
# MAIL_PORT=587
# MAIL_USERNAME=noreply@pens.ac.id
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# PRODUCTION WAJIB JALAN:
# 1. php artisan queue:work --tries=3 (systemd/supervisor, agar notifikasi terkirim)
# 2. * * * * * cd /path && php artisan schedule:run >> /dev/null 2>&1
#    (ketemupens:expire hourly + ketemupens:purge-pii daily)
# 3. php artisan ketemupens:health (cek kesiapan sebelum launch)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Foto barang — lokal (dev) vs Cloudflare R2 (production, Opsi A public bucket).
# Dev: biarkan public. Production: isi R2 + set FILESYSTEM_PHOTOS_DISK=r2,
# lalu sync sekali: aws s3 sync storage/app/public/items s3://$R2_BUCKET/items --endpoint-url $R2_ENDPOINT
FILESYSTEM_DISK=local
FILESYSTEM_PHOTOS_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ketemupens-photos
R2_DEFAULT_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://foto.ketemupens.id
R2_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KETEMU PENS domain rules
# Days a found item may sit on the shelf before it is expired automatically.
ITEM_STALE_AFTER_DAYS=60
# Days before a found report with unconfirmed handover is flagged for follow-up.
ITEM_DEPOSIT_REMINDER_AFTER_DAYS=2

# Telegram bot used for external notifications.
# Get a token from @BotFather. Leave empty to disable Telegram entirely:
# notifications then only appear in the in-app inbox.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret echoed back in X-Telegram-Bot-Api-Secret-Token.
# Generate with: php artisan key:generate --show  (or any random string)
TELEGRAM_WEBHOOK_SECRET=
# Minutes a pickup code stays valid after it is issued.
PICKUP_CODE_VALIDITY_MINUTES=4320
